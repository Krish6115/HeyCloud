# =========================
# AWS Configuration
# =========================
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# =========================
# Event Producer
# =========================
API_GATEWAY_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod
EVENTS_PER_SECOND=10
BATCH_SIZE=25
PRODUCER_LOG_LEVEL=INFO

# =========================
# Kinesis
# =========================
KINESIS_STREAM_NAME=heycloud-event-stream
KINESIS_SHARD_COUNT=1

# =========================
# DynamoDB
# =========================
DYNAMODB_EVENTS_TABLE=heycloud-events
DYNAMODB_AGGREGATIONS_TABLE=heycloud-aggregations
DYNAMODB_TTL_DAYS=7

# =========================
# S3
# =========================
S3_DATA_LAKE_BUCKET=heycloud-data-lake
S3_LAMBDA_ARTIFACTS_BUCKET=heycloud-lambda-artifacts

# =========================
# Monitoring
# =========================
SNS_ALERT_EMAIL=your-email@example.com
CLOUDWATCH_LOG_RETENTION_DAYS=7

# =========================
# Frontend
# =========================
REACT_APP_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod
REACT_APP_POLL_INTERVAL_MS=10000

# =========================
# Terraform
# =========================
TF_STATE_BUCKET=heycloud-terraform-state
TF_STATE_LOCK_TABLE=heycloud-terraform-locks
TF_STATE_REGION=us-east-1
